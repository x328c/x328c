generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   BigInt                      @id @default(autoincrement())
  openid               String                      @unique @db.VarChar(64)
  unionid              String?                     @db.VarChar(64)
  nickname             String                      @db.VarChar(50)
  avatar_url           String?                     @db.VarChar(255)
  gender               Int                         @default(0) @db.TinyInt
  phone                String?                     @unique @db.VarChar(20)
  status               Int                         @default(1) @db.TinyInt
  role                 Int                         @default(0) @db.TinyInt
  forum_invited        Boolean                     @default(false)
  last_login_at        DateTime?                   @db.DateTime(0)
  created_at           DateTime                    @default(now()) @db.DateTime(0)
  updated_at           DateTime                    @updatedAt @db.DateTime(0)
  deleted_at           DateTime?                   @db.DateTime(0)
  profile              UserProfile?
  rides                Ride[]
  ride_entries         RideParticipant[]
  activities           Activity[]
  registrations        ActivityRegistration[]
  notifications        Notification[]              @relation("notification_recipient")
  sent_notifications   Notification[]              @relation("notification_sender")
  filed_reports        Report[]                    @relation("reporter")
  received_reports     Report[]                    @relation("reported_user")
  file_records         FileRecord[]
  route_favorites      RouteFavorite[]
  regulation_feedbacks RegulationFeedback[]
  forum_posts          ForumPost[]
  forum_replies        ForumReply[]
  forum_likes          ForumLike[]
  forum_restrictions   UserRestriction[]
  analytics_events     AnalyticsEvent[]
  route_comments       RouteComment[]
  user_routes          UserRoute[]
  user_route_favorites UserRouteFavorite[]
  safety_acceptances   SafetyAgreementAcceptance[]
  setting              UserSetting?
  app_feedbacks        AppFeedback[]
  legal_acceptances    LegalAcceptance[]

  @@index([unionid])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id                   BigInt    @id @default(autoincrement())
  user_id              BigInt    @unique
  motorcycle_model     String?   @db.VarChar(100)
  riding_years         Int?      @db.TinyInt
  riding_styles        Json?
  province             String?   @db.VarChar(50)
  city                 String?   @db.VarChar(50)
  district             String?   @db.VarChar(50)
  city_code            String?   @db.VarChar(20)
  location_lat         Decimal?  @db.Decimal(10, 7)
  location_lng         Decimal?  @db.Decimal(10, 7)
  location_offset_seed String?   @db.VarChar(32)
  location_visible     Int       @default(2) @db.TinyInt
  bio                  String?   @db.VarChar(200)
  wechat_id            String?   @db.VarChar(50)
  wechat_id_normalized String?   @db.VarChar(50)
  wechat_visible       Int       @default(1) @db.TinyInt
  created_at           DateTime  @default(now()) @db.DateTime(0)
  updated_at           DateTime  @updatedAt @db.DateTime(0)
  deleted_at           DateTime? @db.DateTime(0)
  user                 User      @relation(fields: [user_id], references: [id])

  @@index([city_code])
  @@index([wechat_id_normalized])
  @@map("user_profiles")
}

model Ride {
  id                        BigInt            @id @default(autoincrement())
  user_id                   BigInt
  title                     String            @db.VarChar(50)
  ride_style                Int               @db.TinyInt
  departure_time            DateTime          @db.DateTime(0)
  meetup_address            String            @db.VarChar(200)
  meetup_lat                Decimal           @db.Decimal(10, 7)
  meetup_lng                Decimal           @db.Decimal(10, 7)
  destination               String?           @db.VarChar(200)
  destination_lat           Decimal?          @db.Decimal(10, 7)
  destination_lng           Decimal?          @db.Decimal(10, 7)
  destination_city_code     String?           @db.VarChar(20)
  destination_district_code String?           @db.VarChar(20)
  min_people                Int               @db.TinyInt
  max_people                Int               @db.TinyInt
  speed_level               Int               @db.TinyInt
  bike_requirement          String?           @db.VarChar(100)
  description               String?           @db.Text
  rules                     Json?
  status                    Int               @default(1) @db.TinyInt
  audit_status              Int               @default(1) @db.TinyInt
  view_count                Int               @default(0)
  join_count                Int               @default(0)
  city_code                 String            @db.VarChar(20)
  district_code             String?           @db.VarChar(20)
  route_snapshot            Json?
  route_snapshot_version    Int?
  created_at                DateTime          @default(now()) @db.DateTime(0)
  updated_at                DateTime          @updatedAt @db.DateTime(0)
  deleted_at                DateTime?         @db.DateTime(0)
  user                      User              @relation(fields: [user_id], references: [id])
  participants              RideParticipant[]
  reports                   Report[]          @relation("reported_ride")
  route_links               RouteRideLink[]
  points                    RidePoint[]

  @@index([user_id])
  @@index([departure_time])
  @@index([city_code, status, departure_time])
  @@index([city_code, district_code, status, departure_time], map: "rides_v23_region_departure_idx")
  @@map("rides")
}

model RidePoint {
  id            BigInt   @id @default(autoincrement())
  ride_id       BigInt
  order         Int
  type          String   @db.VarChar(16)
  name          String   @db.VarChar(80)
  address       String?  @db.VarChar(300)
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  province_code String?  @db.VarChar(20)
  city_code     String?  @db.VarChar(20)
  district_code String?  @db.VarChar(20)
  source        String   @default("manual") @db.VarChar(32)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @updatedAt @db.DateTime(0)
  ride          Ride     @relation(fields: [ride_id], references: [id], onDelete: Cascade)

  @@unique([ride_id, order])
  @@index([ride_id, type])
  @@index([city_code, district_code, ride_id])
  @@map("ride_points")
}

model RideParticipant {
  id           BigInt    @id @default(autoincrement())
  ride_id      BigInt
  user_id      BigInt
  status       Int       @default(1) @db.TinyInt
  is_creator   Boolean   @default(false)
  joined_at    DateTime  @default(now()) @db.DateTime(0)
  cancelled_at DateTime? @db.DateTime(0)
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @updatedAt @db.DateTime(0)
  deleted_at   DateTime? @db.DateTime(0)
  ride         Ride      @relation(fields: [ride_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])

  @@unique([ride_id, user_id])
  @@index([ride_id, status])
  @@index([user_id, status])
  @@map("ride_participants")
}

model Activity {
  id                BigInt                 @id @default(autoincrement())
  user_id           BigInt
  title             String                 @db.VarChar(80)
  cover_image       String?                @db.VarChar(255)
  activity_type     Int                    @db.TinyInt
  start_time        DateTime               @db.DateTime(0)
  end_time          DateTime               @db.DateTime(0)
  meetup_address    String                 @db.VarChar(200)
  meetup_lat        Decimal                @db.Decimal(10, 7)
  meetup_lng        Decimal                @db.Decimal(10, 7)
  route_description String?                @db.Text
  max_people        Int                    @default(0)
  fee_type          Int                    @db.TinyInt
  fee_amount        Decimal?               @db.Decimal(10, 2)
  requirements      String?                @db.Text
  content           String?                @db.Text
  contact_name      String?                @db.VarChar(50)
  contact_wechat    String?                @db.VarChar(50)
  need_approval     Boolean                @default(false)
  status            Int                    @default(1) @db.TinyInt
  view_count        Int                    @default(0)
  like_count        Int                    @default(0)
  favorite_count    Int                    @default(0)
  register_count    Int                    @default(0)
  city_code         String                 @db.VarChar(20)
  created_at        DateTime               @default(now()) @db.DateTime(0)
  updated_at        DateTime               @updatedAt @db.DateTime(0)
  deleted_at        DateTime?              @db.DateTime(0)
  user              User                   @relation(fields: [user_id], references: [id])
  registrations     ActivityRegistration[]
  reports           Report[]               @relation("reported_activity")
  route_links       RouteActivityLink[]

  @@index([user_id])
  @@index([city_code, status, start_time])
  @@map("activities")
}

model ActivityRegistration {
  id                BigInt    @id @default(autoincrement())
  activity_id       BigInt
  user_id           BigInt
  real_name         String?   @db.VarChar(50)
  phone             String?   @db.VarChar(50)
  emergency_contact String?   @db.VarChar(50)
  remark            String?   @db.VarChar(200)
  status            Int       @default(1) @db.TinyInt
  reject_reason     String?   @db.VarChar(200)
  registered_at     DateTime  @default(now()) @db.DateTime(0)
  audited_at        DateTime? @db.DateTime(0)
  created_at        DateTime  @default(now()) @db.DateTime(0)
  updated_at        DateTime  @updatedAt @db.DateTime(0)
  deleted_at        DateTime? @db.DateTime(0)
  activity          Activity  @relation(fields: [activity_id], references: [id])
  user              User      @relation(fields: [user_id], references: [id])

  @@unique([activity_id, user_id])
  @@index([activity_id, status])
  @@index([user_id, status])
  @@map("activity_registrations")
}

model Notification {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  type         Int       @db.TinyInt
  title        String    @db.VarChar(100)
  content      String    @db.VarChar(500)
  related_type String?   @db.VarChar(50)
  related_id   BigInt?
  from_user_id BigInt?
  is_read      Boolean   @default(false)
  push_status  Int       @default(0) @db.TinyInt
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @updatedAt @db.DateTime(0)
  deleted_at   DateTime? @db.DateTime(0)
  user         User      @relation("notification_recipient", fields: [user_id], references: [id])
  from_user    User?     @relation("notification_sender", fields: [from_user_id], references: [id])

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

model AdminUser {
  id                              BigInt                 @id @default(autoincrement())
  username                        String                 @unique @db.VarChar(50)
  password_hash                   String                 @db.VarChar(255)
  role                            Int                    @db.TinyInt
  last_login_at                   DateTime?              @db.DateTime(0)
  last_login_ip                   String?                @db.VarChar(45)
  created_at                      DateTime               @default(now()) @db.DateTime(0)
  updated_at                      DateTime               @updatedAt @db.DateTime(0)
  deleted_at                      DateTime?              @db.DateTime(0)
  handled_reports                 Report[]               @relation("report_handler")
  feature_flags                   FeatureFlag[]          @relation("feature_flag_updater")
  operation_logs                  OperationLog[]
  maintained_routes               Route[]
  created_regulations             Regulation[]           @relation("regulation_creator")
  created_regulation_revisions    RegulationRevision[]   @relation("regulation_revision_creator")
  reviewed_regulation_revisions   RegulationRevision[]   @relation("regulation_revision_reviewer")
  regulation_import_tasks         RegulationImportTask[]
  created_forum_restrictions      UserRestriction[]
  task_failures                   TaskFailure[]          @relation("task_failure_resolver")
  created_safety_guide_revisions  SafetyGuideRevision[]  @relation("safety_guide_revision_creator")
  reviewed_safety_guide_revisions SafetyGuideRevision[]  @relation("safety_guide_revision_reviewer")
  created_safety_agreements       SafetyAgreement[]      @relation("safety_agreement_creator")
  reviewed_safety_agreements      SafetyAgreement[]      @relation("safety_agreement_reviewer")
  handled_app_feedbacks           AppFeedback[]          @relation("app_feedback_handler")

  @@map("admin_users")
}

model FeatureFlag {
  id         BigInt     @id @default(autoincrement())
  key        String     @unique @db.VarChar(100)
  value      String     @db.VarChar(64)
  updated_by BigInt?
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime   @updatedAt @db.DateTime(0)
  deleted_at DateTime?  @db.DateTime(0)
  updater    AdminUser? @relation("feature_flag_updater", fields: [updated_by], references: [id])

  @@index([deleted_at])
  @@map("feature_flags")
}

model OperationLog {
  id             BigInt    @id @default(autoincrement())
  admin_id       BigInt
  action         String    @db.VarChar(100)
  object_type    String    @db.VarChar(50)
  object_id      String    @db.VarChar(64)
  before_summary Json?
  after_summary  Json?
  reason         String    @db.VarChar(500)
  ip_address     String?   @db.VarChar(45)
  request_id     String    @db.VarChar(64)
  created_at     DateTime  @default(now()) @db.DateTime(0)
  admin          AdminUser @relation(fields: [admin_id], references: [id])

  @@index([admin_id, created_at])
  @@index([object_type, object_id, created_at])
  @@index([request_id])
  @@map("operation_logs")
}

model Route {
  id                      BigInt              @id @default(autoincrement())
  title                   String              @db.VarChar(80)
  summary                 String?             @db.VarChar(300)
  cover_image             String?             @db.VarChar(500)
  images                  Json?
  city_code               String?             @db.VarChar(20)
  district_code           String?             @db.VarChar(20)
  city_name               String?             @db.VarChar(50)
  type                    String?             @db.VarChar(32)
  difficulty              String?             @db.VarChar(20)
  distance_km             Decimal?            @db.Decimal(8, 2)
  duration_min            Int?
  polyline                Json?
  polyline_status         Int                 @default(0) @db.TinyInt
  polyline_provider       String?             @db.VarChar(32)
  polyline_updated_at     DateTime?           @db.DateTime(0)
  external_route_url      String?             @db.VarChar(1000)
  external_route_provider String?             @db.VarChar(32)
  external_url_status     Int                 @default(0) @db.TinyInt
  road_condition          String?             @db.VarChar(500)
  suitable_motorcycles    String?             @db.VarChar(200)
  best_season             String?             @db.VarChar(100)
  safety_notice           String?             @db.VarChar(1000)
  status                  Int                 @default(0) @db.TinyInt
  sort_weight             Int                 @default(0)
  maintainer_id           BigInt
  favorite_count          Int                 @default(0)
  published_at            DateTime?           @db.DateTime(0)
  offlined_at             DateTime?           @db.DateTime(0)
  offline_reason          String?             @db.VarChar(500)
  created_at              DateTime            @default(now()) @db.DateTime(0)
  updated_at              DateTime            @updatedAt @db.DateTime(0)
  deleted_at              DateTime?           @db.DateTime(0)
  maintainer              AdminUser           @relation(fields: [maintainer_id], references: [id])
  points                  RoutePoint[]
  favorites               RouteFavorite[]
  ride_links              RouteRideLink[]
  activity_links          RouteActivityLink[]
  comments                RouteComment[]
  regions                 RouteRegion[]

  @@index([status, sort_weight, updated_at, id])
  @@index([status, city_code, sort_weight, updated_at, id])
  @@index([status, city_code, district_code, sort_weight, updated_at, id], map: "routes_v23_region_sort_idx")
  @@index([status, type, difficulty, sort_weight, updated_at, id])
  @@index([maintainer_id, status, updated_at])
  @@index([deleted_at])
  @@map("routes")
}

model RoutePoint {
  id            BigInt   @id @default(autoincrement())
  route_id      BigInt
  order         Int
  name          String   @db.VarChar(80)
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  type          String   @db.VarChar(16)
  description   String?  @db.VarChar(300)
  address       String?  @db.VarChar(300)
  province_code String?  @db.VarChar(20)
  city_code     String?  @db.VarChar(20)
  district_code String?  @db.VarChar(20)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @updatedAt @db.DateTime(0)
  route         Route    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@unique([route_id, order])
  @@index([route_id, type])
  @@index([city_code, district_code, route_id], map: "route_points_v23_region_idx")
  @@map("route_points")
}

model RouteRegion {
  id            BigInt   @id @default(autoincrement())
  route_id      BigInt
  city_code     String   @db.VarChar(20)
  district_code String   @default("") @db.VarChar(20)
  has_start     Boolean  @default(false)
  has_waypoint  Boolean  @default(false)
  point_count   Int      @default(1)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @updatedAt @db.DateTime(0)
  route         Route    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@unique([route_id, city_code, district_code])
  @@index([city_code, district_code, route_id])
  @@map("route_regions")
}

model RouteFavorite {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  route_id   BigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@unique([user_id, route_id])
  @@index([route_id, created_at])
  @@map("route_favorites")
}

model UserRoute {
  id                      BigInt              @id @default(autoincrement())
  user_id                 BigInt
  title                   String              @db.VarChar(100)
  description             String?             @db.Text
  start_location          String              @db.VarChar(200)
  start_lat               Decimal             @db.Decimal(10, 7)
  start_lng               Decimal             @db.Decimal(10, 7)
  end_location            String?             @db.VarChar(200)
  end_lat                 Decimal?            @db.Decimal(10, 7)
  end_lng                 Decimal?            @db.Decimal(10, 7)
  waypoints               Json?
  city_code               String?             @db.VarChar(20)
  district_code           String?             @db.VarChar(20)
  polyline                Json?
  polyline_status         Int                 @default(0) @db.TinyInt
  polyline_provider       String?             @db.VarChar(32)
  polyline_updated_at     DateTime?           @db.DateTime(0)
  external_route_url      String?             @db.VarChar(1000)
  external_route_provider String?             @db.VarChar(32)
  external_url_status     Int                 @default(0) @db.TinyInt
  route_data_version      Int                 @default(2)
  total_distance          Int?
  estimated_time          Int?
  difficulty              Int?                @db.TinyInt
  images                  Json?
  visibility              Int                 @default(1) @db.TinyInt
  view_count              Int                 @default(0)
  favorite_count          Int                 @default(0)
  status                  Int                 @default(1) @db.TinyInt
  offlined_at             DateTime?           @db.DateTime(0)
  offline_reason          String?             @db.VarChar(500)
  offlined_by             BigInt?
  created_at              DateTime            @default(now()) @db.DateTime(0)
  updated_at              DateTime            @updatedAt @db.DateTime(0)
  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  favorites               UserRouteFavorite[]
  comments                RouteComment[]
  ride_links              RouteRideLink[]
  points                  UserRoutePoint[]
  regions                 UserRouteRegion[]

  @@index([user_id, status, created_at, id])
  @@index([visibility, status, created_at, id])
  @@index([visibility, status, city_code, district_code, created_at, id], map: "user_routes_v23_region_created_idx")
  @@index([visibility, status, difficulty, total_distance, created_at, id], map: "user_routes_public_filter_idx")
  @@index([status, offlined_at, id], map: "user_routes_admin_status_idx")
  @@map("user_routes")
}

model UserRoutePoint {
  id            BigInt    @id @default(autoincrement())
  user_route_id BigInt
  order         Int
  type          String    @db.VarChar(16)
  name          String    @db.VarChar(80)
  address       String?   @db.VarChar(300)
  latitude      Decimal   @db.Decimal(10, 7)
  longitude     Decimal   @db.Decimal(10, 7)
  province_code String?   @db.VarChar(20)
  city_code     String?   @db.VarChar(20)
  district_code String?   @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @updatedAt @db.DateTime(0)
  user_route    UserRoute @relation(fields: [user_route_id], references: [id], onDelete: Cascade)

  @@unique([user_route_id, order])
  @@index([user_route_id, type])
  @@index([city_code, district_code, user_route_id])
  @@map("user_route_points")
}

model UserRouteRegion {
  id            BigInt    @id @default(autoincrement())
  user_route_id BigInt
  city_code     String    @db.VarChar(20)
  district_code String    @default("") @db.VarChar(20)
  has_start     Boolean   @default(false)
  has_waypoint  Boolean   @default(false)
  point_count   Int       @default(1)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @updatedAt @db.DateTime(0)
  user_route    UserRoute @relation(fields: [user_route_id], references: [id], onDelete: Cascade)

  @@unique([user_route_id, city_code, district_code])
  @@index([city_code, district_code, user_route_id])
  @@map("user_route_regions")
}

model UserRouteFavorite {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  user_route_id BigInt
  created_at    DateTime  @default(now()) @db.DateTime(0)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_route    UserRoute @relation(fields: [user_route_id], references: [id], onDelete: Cascade)

  @@unique([user_id, user_route_id])
  @@index([user_route_id, created_at])
  @@map("user_route_favorites")
}

model RouteRideLink {
  id            BigInt     @id @default(autoincrement())
  route_id      BigInt?
  user_route_id BigInt?
  ride_id       BigInt
  source        String     @default("manual") @db.VarChar(32)
  created_at    DateTime   @default(now()) @db.DateTime(0)
  route         Route?     @relation(fields: [route_id], references: [id], onDelete: Cascade)
  user_route    UserRoute? @relation(fields: [user_route_id], references: [id], onDelete: Cascade)
  ride          Ride       @relation(fields: [ride_id], references: [id], onDelete: Cascade)

  @@unique([route_id, ride_id])
  @@unique([user_route_id, ride_id])
  @@index([ride_id])
  @@index([user_route_id])
  @@map("route_ride_links")
}

model RouteActivityLink {
  id          BigInt   @id @default(autoincrement())
  route_id    BigInt
  activity_id BigInt
  source      String   @default("create_form") @db.VarChar(32)
  created_at  DateTime @default(now()) @db.DateTime(0)
  route       Route    @relation(fields: [route_id], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([route_id, activity_id])
  @@index([activity_id])
  @@map("route_activity_links")
}

model RouteComment {
  id                  BigInt     @id @default(autoincrement())
  route_id            BigInt?
  user_route_id       BigInt?
  user_id             BigInt
  content             String     @db.VarChar(500)
  images              Json?
  content_hash        String     @db.Char(64)
  idempotency_key     String     @db.VarChar(128)
  status              Int        @default(1) @db.TinyInt
  report_count        Int        @default(0)
  reported_at         DateTime?  @db.DateTime(0)
  moderation_status   Int        @default(1) @db.TinyInt
  moderation_attempts Int        @default(0) @db.TinyInt
  next_retry_at       DateTime?  @db.DateTime(0)
  rejection_reason    String?    @db.VarChar(500)
  offline_reason      String?    @db.VarChar(500)
  published_at        DateTime?  @db.DateTime(0)
  created_at          DateTime   @default(now()) @db.DateTime(0)
  updated_at          DateTime   @updatedAt @db.DateTime(0)
  deleted_at          DateTime?  @db.DateTime(0)
