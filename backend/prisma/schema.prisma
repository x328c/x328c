  last_error_summary String?    @db.VarChar(500)
  payload_summary    Json?
  first_failed_at    DateTime   @default(now()) @db.DateTime(0)
  last_failed_at     DateTime   @default(now()) @db.DateTime(0)
  next_retry_at      DateTime?  @db.DateTime(0)
  resolved_by        BigInt?
  resolved_at        DateTime?  @db.DateTime(0)
  resolution_note    String?    @db.VarChar(500)
  created_at         DateTime   @default(now()) @db.DateTime(0)
  updated_at         DateTime   @updatedAt @db.DateTime(0)
  resolver           AdminUser? @relation("task_failure_resolver", fields: [resolved_by], references: [id])

  @@index([status, next_retry_at, last_failed_at])
  @@index([task_key, status, updated_at])
  @@map("task_failures")
}
