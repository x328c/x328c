# 这是模板文件。请用 deploy/scripts/init-production-env.sh 生成真正的
# .env.production；它包含密钥，绝不能提交到仓库或公开上传。
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai

# Docker 内的 MySQL。初始化脚本生成的密码只包含十六进制字符，可安全写入 DATABASE_URL。
MYSQL_DATABASE=jiangxing_db
MYSQL_USER=jiangxing
MYSQL_PASSWORD=replace_with_a_64_char_hex_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_64_char_hex_password
DATABASE_URL=mysql://jiangxing:replace_with_a_64_char_hex_password@mysql:3306/jiangxing_db
RUN_PRISMA_MIGRATIONS=true

# Docker 内的 Redis。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_64_char_hex_password
REDIS_DB=0

# 三个 JWT 密钥必须不同，且长度不少于 32 个字符。
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_third_random_64_char_hex_secret
ADMIN_JWT_EXPIRES_IN=8h

# 生产微信登录必填。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 仅在已配置腾讯云 CMS 密钥后才启用。
CONTENT_SECURITY_ENABLED=false
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CMS_REGION=ap-guangzhou

# COS 临时上传凭证和稳定图片访问域名所必需。
# COS_CDN_DOMAIN 应填写已配置私有源站回源鉴权的 CDN/自定义域名；不要把私有桶默认源站域名直接作为公开图片地址。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-chengdu
COS_CDN_DOMAIN=
COS_APP_ID=

# 可选道路折线规划与后台地图展示：分别限制服务端来源和后台域名，绝不用于地区逆解析。
TENCENT_MAP_ROUTE_KEY=
TENCENT_MAP_ROUTE_SECRET=
VITE_API_BASE_URL=/api/v1
VITE_TENCENT_MAP_KEY=

# 兼容旧变量；当前 FileService 实际读取上方的 COS_* 变量。
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

SUBSCRIPTION_MESSAGE_ENABLED=false
WECHAT_SUBSCRIBE_RIDE_JOIN_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_DEPARTURE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_CANCEL_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_AUDIT_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_CANCEL_TEMPLATE_ID=
