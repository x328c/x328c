# 服务配置
NODE_ENV=development
PORT=3000

# 数据库配置
DATABASE_URL="mysql://root:123456@localhost:3306/jiangxing_db"

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_ACCESS_SECRET=your-access-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 管理后台 JWT（独立于小程序用户令牌）
ADMIN_JWT_SECRET=your-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=8h

# 微信小程序配置
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-secret

# 腾讯云配置
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
TENCENT_COS_BUCKET=your-bucket
TENCENT_COS_REGION=ap-beijing

# 腾讯云内容安全（生产环境设置为 true，并配置上述腾讯云密钥）
CONTENT_SECURITY_ENABLED=false
TENCENT_CMS_REGION=ap-guangzhou

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_CDN_DOMAIN=
COS_APP_ID=

# 微信订阅消息（开发环境保持 false）
SUBSCRIPTION_MESSAGE_ENABLED=false
WECHAT_SUBSCRIBE_RIDE_JOIN_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_DEPARTURE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_CANCEL_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_AUDIT_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_CANCEL_TEMPLATE_ID=
