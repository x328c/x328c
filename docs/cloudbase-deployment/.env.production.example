# 基础运行配置
NODE_ENV=production
PORT=3000

# MySQL（云托管请填写云数据库内网地址；数据库名应为 jiangxing_db）
DATABASE_URL="mysql://db_user:db_password@mysql.internal.example.com:3306/jiangxing_db"
# 控制首次部署是否执行 Prisma migration。保持 true；仅排障或多副本滚动部署时才设为 false。
RUN_PRISMA_MIGRATIONS=true

# Redis：当前后端实际读取以下四项。
REDIS_HOST=redis.internal.example.com
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0
# REDIS_URL=redis://:replace_with_redis_password@redis.internal.example.com:6379/0
# 注：REDIS_URL 仅作连接串记录；当前代码尚未读取它，请务必填写上方 REDIS_HOST/PORT/PASSWORD/DB。

# 小程序用户 JWT：使用长度不少于 32 字符的随机值。
JWT_ACCESS_SECRET=replace_with_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 管理后台 JWT（必须与小程序 JWT 使用不同随机值）
ADMIN_JWT_SECRET=replace_with_random_admin_secret_at_least_32_chars
ADMIN_JWT_EXPIRES_IN=8h

# 微信小程序登录（生产 AppID / AppSecret）
WECHAT_APP_ID=wx_your_production_appid
WECHAT_APP_SECRET=your_production_app_secret

# 腾讯云内容安全：启用后需要有效的腾讯云 API 密钥。
CONTENT_SECURITY_ENABLED=true
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_CMS_REGION=ap-guangzhou

# 腾讯云 COS 直传 / STS（COS_SECRET_* 与内容安全密钥可为同一腾讯云账号，按最小权限配置）
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_BUCKET=jiangxing-1234567890
COS_REGION=ap-chengdu
COS_CDN_DOMAIN=cdn.example.com
COS_APP_ID=1234567890

# 旧版 COS 环境变量：当前 FileService 不读取；如其他扩展服务使用可保留。
TENCENT_COS_BUCKET=jiangxing-1234567890
TENCENT_COS_REGION=ap-chengdu

# 微信订阅消息；暂不推送时保持 false，模板 ID 可留空。
SUBSCRIPTION_MESSAGE_ENABLED=false
WECHAT_SUBSCRIBE_RIDE_JOIN_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_DEPARTURE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_RIDE_CANCEL_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_AUDIT_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ACTIVITY_CANCEL_TEMPLATE_ID=
